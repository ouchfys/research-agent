{
  "name": "research-bookshelf",
  "productName": "研究书架",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/electron/main.cjs",
  "description": "本地优先的个人 AI 研究知识库",
  "author": "Research Bookshelf",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "clean": "node scripts/clean.mjs",
    "build": "npm run typecheck && vite build && node scripts/build.mjs",
    "start": "node scripts/start.mjs",
    "setup:media": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-media.ps1",
    "pack:win": "npm run setup:media && npm run build && electron-builder --win nsis",
    "pack:dir": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.0.2",
    "@earendil-works/pi-coding-agent": "1.0.2",
    "@mozilla/readability": "0.6.0",
    "diff": "9.0.0",
    "dotenv": "18.0.5",
    "katex": "0.19.0",
    "linkedom": "0.18.13",
    "lucide-react": "1.51.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "rehype-highlight": "7.0.2",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "typebox": "1.3.27",
    "undici": "8.11.2",
    "unzipper": "0.12.5",
    "zod": "4.6.5"
  },
  "build": {
    "appId": "local.research.bookshelf",
    "productName": "研究书架",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "tools",
        "to": "tools"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "devDependencies": {
    "@types/diff": "7.0.2",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/unzipper": "0.10.11",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "40.10.6",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vite": "7.3.6"
  }
}
