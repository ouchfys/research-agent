# Copy to .env in this project, or select the file in Settings.
# Real .env files / credentials are never included in the application package.
# Usually these two provider keys are all the model configuration you need.
# Existing aliases are accepted too: deepseek_api and aliyunbailian-api-key.
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=

# When there is no saved selection, a DeepSeek key selects DeepSeek V4.1 Flash.
# Official DeepSeek API: https://api.deepseek.com + model deepseek-flash.
# The same model on Aliyun has a DIFFERENT ID: deepseek-v4.1-flash.
# Otherwise the default is Aliyun qwen3.8-flash. Both support text and images.
# Optional advanced overrides; leave commented to keep the automatic defaults.
# TEXT_BASE_URL=https://api.deepseek.com
# TEXT_MODEL=deepseek-flash
# TEXT_API_KEY=

# Uploaded images follow the main model by default. To configure a separate model:
# VISION_USE_TEXT_MODEL=false
# VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# VISION_MODEL=qwen3.8-flash
# VISION_API_KEY=

# Uploaded images, Douyin picture posts, and sampled video frames share
# the effective visual model above. A text-only main model needs a separate
# image-capable visual model (VISION_USE_TEXT_MODEL=false).

# ASR defaults to Aliyun qwen3-asr-flash and shares DASHSCOPE_API_KEY.
# dashscope: chat/completions + input_audio Data URI, <=10 MB after Base64.
# openai: multipart audio/transcriptions for another compatible ASR service.
# TRANSCRIPTION_PROTOCOL=dashscope
# TRANSCRIPTION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# TRANSCRIPTION_MODEL=qwen3-asr-flash
# TRANSCRIPTION_API_KEY=

# Keys saved manually in Settings take priority over automatic .env reads.
# Selecting / reloading the associated .env explicitly adopts its keys again.
# Saved model selections remain in place unless changed in Settings.

# Web search uses DeepSeek official and shares DEEPSEEK_API_KEY above.
# It calls https://api.deepseek.com/anthropic/v1/messages with deepseek-flash
# and the server-side web_search_20250305 tool. No separate search key is needed.
# Each search adds one Messages model round; structured results are required.
# Missing credentials, service errors, or missing results are reported explicitly.
# Public paper lookup and direct URL reading do not require this search key.

# Paper parsing: prefer arXiv structured HTML; use MinerU for PDF content.
# Missing/failed PDF parsing is reported explicitly; an arXiv abstract is not full text.
# Non-empty paper connection settings are read at startup; missing fields retain
# saved values. A manually saved token takes priority for the same service origin.
# Explicitly importing / reloading this file adopts its non-empty token again.
ARXIV_HTML_BASE_URL=https://arxiv.org/html
# Integer seconds, 1..300.
ARXIV_HTML_TIMEOUT_SECONDS=60
MINERU_API_BASE_URL=https://mineru.net/api/v4
MINERU_MODEL_VERSION=vlm
# Keep the real token only in your local .env or local configuration.
# An empty token preserves a previously saved token; public settings never return it.
MINERU_API_TOKEN=
# Total request budget, integer seconds 1..3600.
MINERU_TIMEOUT_SECONDS=600
# Integer seconds 1..60; must not exceed the total timeout.
MINERU_POLL_INTERVAL_SECONDS=4

# Windows builds bundle yt-dlp, FFmpeg, and FFprobe. Source setup: npm run setup:media.
# pack:win prepares these tools and verifies upstream SHA-256 before building.
# Runtime lookup: valid user path, bundled SHELF_TOOLS_DIR, then PATH.
# Overrides are optional; keep FFprobe beside an overridden FFmpeg executable.
# ASR uses 60-second WAV windows, covering at most the first 20 minutes.
# Video samples at most 24 frames across that window; timestamps mark extraction
# targets / audio windows, not exact frame PTS or sentence/word alignment.
# Paths are passed to spawn without a shell; no automatic runtime upgrade.
YT_DLP_PATH=
FFMPEG_PATH=

# Optional manually exported Netscape Cookies file (local absolute path, <=2 MB).
# The application filters cookies by the requested platform and uses a temporary jar.
# It never reads browser cookies automatically or sends cookie contents to models.
# Prefer Settings -> advanced media settings to set or clear this path.
# MEDIA_COOKIES_PATH=

# Initial absolute writable data directory. Empty uses .local/data in development,
# or Electron userData/data after packaging. For an existing library use Settings:
# copy the entire current library to an empty folder (old folder retained),
# or open an existing / empty library immediately. No app restart is needed.
SHELF_DATA_DIR=
